{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai2d.local/schemas/localization-v1.schema.json",
  "title": "AI2D localization table v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "strings"],
  "properties": {
    "schema_version": {"const": "1"},
    "strings": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 4096,
      "propertyNames": {"minLength": 1, "maxLength": 256},
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 4096}
    }
  }
}
