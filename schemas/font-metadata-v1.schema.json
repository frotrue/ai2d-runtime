{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai2d.local/schemas/font-metadata-v1.schema.json",
  "title": "AI2D font metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "line_height", "glyphs"],
  "properties": {
    "schema_version": {"const": "1"},
    "line_height": {"type": "number", "exclusiveMinimum": 0, "maximum": 3.4028234663852886e38},
    "glyphs": {"type": "array", "minItems": 1, "maxItems": 65536, "items": {"$ref": "#/$defs/glyph"}}
  },
  "$defs": {
    "finite": {"type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38},
    "vec2": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/finite"}, {"$ref": "#/$defs/finite"}], "items": false},
    "uv": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}], "items": false},
    "glyph": {"type": "object", "additionalProperties": false, "required": ["codepoint", "uv", "size", "bearing", "advance"], "properties": {"codepoint": {"type": "integer", "minimum": 1, "maximum": 1114111}, "uv": {"$ref": "#/$defs/uv"}, "size": {"$ref": "#/$defs/vec2"}, "bearing": {"$ref": "#/$defs/vec2"}, "advance": {"type": "number", "minimum": 0, "maximum": 3.4028234663852886e38}}}
  }
}
