{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai2d.local/schemas/game-manifest-v0.6.schema.json",
  "title": "AI2D GameManifest 0.6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "organization", "application", "window", "assets", "actions", "input_profiles", "default_input_profile", "states", "scenes", "start_scene", "transitions"],
  "properties": {
    "schema_version": {"const": "0.6"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "name": {"$ref": "#/$defs/id"},
    "organization": {"$ref": "#/$defs/preference_component"},
    "application": {"$ref": "#/$defs/preference_component"},
    "window": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "width", "height", "virtual_width", "virtual_height", "default_fps"],
      "properties": {
        "title": {"$ref": "#/$defs/id"}, "width": {"type": "integer", "minimum": 1, "maximum": 16384},
        "height": {"type": "integer", "minimum": 1, "maximum": 16384},
        "virtual_width": {"type": "integer", "minimum": 1, "maximum": 16384},
        "virtual_height": {"type": "integer", "minimum": 1, "maximum": 16384},
        "default_fps": {"$ref": "#/$defs/fps"}
      }
    },
    "assets": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/asset"}},
    "animations": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/animation"}},
    "prefabs": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/external_declaration"}},
    "localizations": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["locale", "path"], "properties": {"locale": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/path"}}}},
    "default_locale": {"$ref": "#/$defs/id"},
    "actions": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/action"}},
    "input_profiles": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/input_profile"}},
    "default_input_profile": {"$ref": "#/$defs/id"},
    "states": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/state"}},
    "save": {"type": "object", "additionalProperties": false, "required": ["slots", "states"], "properties": {"slots": {"type": "integer", "minimum": 1, "maximum": 16}, "states": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "scenes": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["id", "path"], "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/path"}}}},
    "start_scene": {"$ref": "#/$defs/id"},
    "transitions": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/transition"}},
    "fps_actions": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["action", "cap"], "properties": {"action": {"$ref": "#/$defs/id"}, "cap": {"$ref": "#/$defs/fps"}}}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "preference_component": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?$", "not": {"pattern": "^(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$)"}},
    "path": {"type": "string", "minLength": 1, "maxLength": 1024},
    "fps": {"enum": ["60", "120", "144", "240", "unlimited"]},
    "asset": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["id", "kind", "path"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["png", "wav", "music"]}, "path": {"$ref": "#/$defs/path"}}},
      {"type": "object", "additionalProperties": false, "required": ["id", "kind", "path", "metadata"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"const": "font"}, "path": {"$ref": "#/$defs/path"}, "metadata": {"$ref": "#/$defs/path"}}}
    ]},
    "action": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"$ref": "#/$defs/id"}, "keys": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}, "mouse_left": {"type": "boolean"}}},
    "key": {"enum": ["escape", "left", "right", "up", "down", "a", "d", "space", "enter", "tab", "w", "s", "q", "e", "r", "f", "left_shift", "left_control"]},
    "animation": {"type": "object", "additionalProperties": false, "required": ["id", "texture", "mode", "frames"], "properties": {"id": {"$ref": "#/$defs/id"}, "texture": {"$ref": "#/$defs/id"}, "mode": {"enum": ["once", "loop", "ping_pong"]}, "frames": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["uv", "duration_ticks"], "properties": {"uv": {"$ref": "#/$defs/rect"}, "duration_ticks": {"type": "integer", "minimum": 1, "maximum": 1000000}}}}}},
    "external_declaration": {"type": "object", "additionalProperties": false, "required": ["id", "path"], "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/path"}}},
    "input_profile": {"type": "object", "additionalProperties": false, "required": ["id", "bindings"], "properties": {"id": {"$ref": "#/$defs/id"}, "bindings": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/profile_binding"}}}},
    "profile_binding": {"type": "object", "additionalProperties": false, "required": ["action"], "properties": {"action": {"$ref": "#/$defs/id"}, "keys": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}, "mouse_left": {"type": "boolean"}, "gamepad_buttons": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"enum": ["south", "east", "west", "north", "back", "start", "left_stick", "right_stick", "left_shoulder", "right_shoulder", "dpad_up", "dpad_down", "dpad_left", "dpad_right"]}}, "gamepad_axes": {"type": "array", "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["axis", "direction"], "properties": {"axis": {"enum": ["left_x", "left_y", "right_x", "right_y", "left_trigger", "right_trigger"]}, "direction": {"enum": ["positive", "negative"]}, "deadzone": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.95}}}}}},
    "rect": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false},
    "state": {"type": "object", "additionalProperties": false, "required": ["id", "initial", "min", "max"], "properties": {"id": {"$ref": "#/$defs/id"}, "initial": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}, "min": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}, "max": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}}},
    "condition": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "action"], "properties": {"kind": {"const": "action_pressed"}, "action": {"$ref": "#/$defs/id"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "state", "value"], "properties": {"kind": {"enum": ["int_state_at_most", "int_state_at_least"]}, "state": {"$ref": "#/$defs/id"}, "value": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "group"], "properties": {"kind": {"const": "group_inactive"}, "group": {"$ref": "#/$defs/id"}}}
    ]},
    "transition": {"type": "object", "additionalProperties": false, "required": ["from", "condition", "to"], "properties": {"from": {"$ref": "#/$defs/id"}, "condition": {"$ref": "#/$defs/condition"}, "to": {"type": "string", "minLength": 1}, "reset_scene": {"type": "boolean"}, "reset_session": {"type": "boolean"}}}
  }
}
