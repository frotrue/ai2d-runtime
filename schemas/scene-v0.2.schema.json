{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai2d.local/schemas/scene-v0.2.schema.json",
  "title": "AI2D SceneSpec 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "world", "camera", "spawn_groups", "systems"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "id": {"$ref": "#/$defs/id"},
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity"],
      "properties": {"capacity": {"type": "integer", "minimum": 1, "maximum": 10000}}
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {"$ref": "#/$defs/vec2"},
        "half_extent": {"$ref": "#/$defs/positive_vec2"}
      }
    },
    "collision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bounds": {"$ref": "#/$defs/vec4"},
        "cell_size": {"$ref": "#/$defs/positive_vec2"},
        "max_colliders": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_grid_references": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "max_candidate_pairs": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "max_impacts": {"type": "integer", "minimum": 1, "maximum": 16}
      }
    },
    "spawn_groups": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/spawn"}},
    "systems": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/system"}},
    "collision_rules": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/rule"}},
    "ui": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/ui"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "number": {"type": "number", "minimum": -3.4028235e38, "maximum": 3.4028235e38},
    "vec2": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/number"}, {"$ref": "#/$defs/number"}], "items": false},
    "positive_vec2": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}], "items": false},
    "vec4": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{"$ref": "#/$defs/number"}, {"$ref": "#/$defs/number"}, {"$ref": "#/$defs/number"}, {"$ref": "#/$defs/number"}], "items": false},
    "color": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}], "items": false},
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "origin", "spacing", "columns"],
      "properties": {
        "kind": {"const": "grid"},
        "origin": {"$ref": "#/$defs/vec2"},
        "spacing": {"$ref": "#/$defs/vec2"},
        "columns": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position_offset": {"$ref": "#/$defs/vec2"},
        "rotation": {"$ref": "#/$defs/number"},
        "scale": {"$ref": "#/$defs/positive_vec2"}
      }
    },
    "velocity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"linear": {"$ref": "#/$defs/vec2"}, "angular": {"$ref": "#/$defs/number"}}
    },
    "sprite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["texture", "size"],
      "properties": {
        "texture": {"$ref": "#/$defs/id"},
        "size": {"$ref": "#/$defs/positive_vec2"},
        "pivot": {"$ref": "#/$defs/vec2"},
        "uv": {"$ref": "#/$defs/vec4"},
        "tint": {"$ref": "#/$defs/color"},
        "layer": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
        "visible": {"type": "boolean"}
      }
    },
    "collider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["half_extent", "group", "body"],
      "properties": {
        "offset": {"$ref": "#/$defs/vec2"},
        "half_extent": {"$ref": "#/$defs/positive_vec2"},
        "group": {"$ref": "#/$defs/id"},
        "body": {"enum": ["static", "kinematic", "dynamic"]},
        "trigger": {"type": "boolean"},
        "enabled": {"type": "boolean"}
      }
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "count", "placement"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "placement": {"$ref": "#/$defs/placement"},
        "transform": {"$ref": "#/$defs/transform"},
        "velocity": {"$ref": "#/$defs/velocity"},
        "sprite": {"$ref": "#/$defs/sprite"},
        "collider": {"$ref": "#/$defs/collider"}
      }
    },
    "system": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "operation", "group", "negative_action", "positive_action", "speed", "min", "max"],
          "properties": {
            "id": {"$ref": "#/$defs/id"}, "operation": {"const": "axis_control"}, "group": {"$ref": "#/$defs/id"},
            "negative_action": {"$ref": "#/$defs/id"}, "positive_action": {"$ref": "#/$defs/id"},
            "speed": {"type": "number", "exclusiveMinimum": 0}, "min": {"$ref": "#/$defs/number"}, "max": {"$ref": "#/$defs/number"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "operation", "group", "action", "velocity"],
          "properties": {
            "id": {"$ref": "#/$defs/id"}, "operation": {"const": "set_velocity_on_press"}, "group": {"$ref": "#/$defs/id"},
            "action": {"$ref": "#/$defs/id"}, "velocity": {"$ref": "#/$defs/vec2"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "operation"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "operation": {"const": "simulate_collisions"}}
        }
      ]
    },
    "reaction": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "target"], "properties": {"kind": {"enum": ["reflect", "deactivate"]}, "target": {"enum": ["a", "b"]}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "state", "value"], "properties": {"kind": {"const": "add_int_state"}, "state": {"$ref": "#/$defs/id"}, "value": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "group"], "properties": {"kind": {"const": "reset_group"}, "group": {"$ref": "#/$defs/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "asset"], "properties": {"kind": {"const": "play_sound"}, "asset": {"$ref": "#/$defs/id"}}}
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b", "reactions"],
      "properties": {
        "a": {"$ref": "#/$defs/id"}, "b": {"$ref": "#/$defs/id"},
        "reactions": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/reaction"}}
      }
    },
    "ui": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["id", "kind", "position", "size"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"const": "panel"}, "position": {"$ref": "#/$defs/vec2"}, "size": {"$ref": "#/$defs/positive_vec2"}, "color": {"$ref": "#/$defs/color"}, "hover_color": {"$ref": "#/$defs/color"}, "layer": {"type": "integer"}, "text_scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 16}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["id", "kind", "position", "size", "text", "font"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"const": "text"}, "position": {"$ref": "#/$defs/vec2"}, "size": {"$ref": "#/$defs/positive_vec2"}, "text": {"$ref": "#/$defs/id"}, "font": {"$ref": "#/$defs/id"}, "color": {"$ref": "#/$defs/color"}, "hover_color": {"$ref": "#/$defs/color"}, "text_color": {"$ref": "#/$defs/color"}, "layer": {"type": "integer"}, "text_scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 16}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["id", "kind", "position", "size", "text", "font", "action"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"const": "button"}, "position": {"$ref": "#/$defs/vec2"}, "size": {"$ref": "#/$defs/positive_vec2"}, "text": {"$ref": "#/$defs/id"}, "font": {"$ref": "#/$defs/id"}, "action": {"$ref": "#/$defs/id"}, "color": {"$ref": "#/$defs/color"}, "hover_color": {"$ref": "#/$defs/color"}, "text_color": {"$ref": "#/$defs/color"}, "layer": {"type": "integer"}, "text_scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 16}}
        }
      ]
    }
  }
}
