{
  "schema_version":"0.3","seed":77,"name":"AI2D Grid Collector","organization":"ai2d","application":"grid_collector",
  "window":{"title":"AI2D Grid Collector","width":960,"height":720,"virtual_width":960,"virtual_height":720,"default_fps":"60"},
  "assets":[{"id":"sprites","kind":"png","path":"assets/sprites.png"},{"id":"font","kind":"font","path":"assets/font.png","metadata":"assets/font.json"}],
  "actions":[{"id":"up","keys":["up"]},{"id":"down","keys":["down"]},{"id":"left","keys":["left","a"]},{"id":"right","keys":["right","d"]},{"id":"restart","keys":["space","enter"]},{"id":"quit","keys":["escape"]}],
  "states":[{"id":"score","initial":0,"min":0,"max":5},{"id":"hazard_count","initial":0,"min":0,"max":5},{"id":"alive","initial":1,"min":0,"max":1},{"id":"gem_available","initial":1,"min":0,"max":1}],
  "scenes":[{"id":"game","path":"scenes/game.json"},{"id":"win","path":"scenes/win.json"},{"id":"lose","path":"scenes/lose.json"}],"start_scene":"game",
  "transitions":[
    {"from":"game","condition":{"kind":"int_state_at_least","state":"score","value":5},"to":"win","reset_scene":true},
    {"from":"game","condition":{"kind":"int_state_at_most","state":"gem_available","value":0},"to":"win","reset_scene":true},
    {"from":"game","condition":{"kind":"int_state_at_most","state":"alive","value":0},"to":"lose","reset_scene":true},
    {"from":"game","condition":{"kind":"action_pressed","action":"quit"},"to":"$quit"},
    {"from":"win","condition":{"kind":"action_pressed","action":"restart"},"to":"game","reset_scene":true,"reset_session":true},
    {"from":"lose","condition":{"kind":"action_pressed","action":"restart"},"to":"game","reset_scene":true,"reset_session":true}
  ]
}
