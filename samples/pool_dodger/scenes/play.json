        "group": "pickup",
        "body": "dynamic",
        "trigger": true
      }
    }
  ],
  "pools": [
    {
      "id": "hazards",
      "group": "hazard_slots",
      "on_exhausted": "recycle_oldest"
    },
    {
      "id": "pickups",
      "group": "pickup_slots",
      "on_exhausted": "skip"
    }
  ],
  "systems": [
    {
      "id": "move_player",
      "operation": "axis_control",
      "group": "player",
      "negative_action": "move_left",
      "positive_action": "move_right",
      "speed": 5,
      "min": -7.2,
      "max": 7.2
    },
    {
      "id": "collisions",
      "operation": "simulate_collisions"
    }
  ],
  "collision_rules": [
    {
      "id": "player_hits_hazard",
      "a": "player",
      "b": "hazard",
      "reactions": [
        {
          "kind": "add_int_state",
          "state": "health",
          "value": -1
        }
      ]
    },
    {
      "id": "player_gets_pickup",
      "a": "player",
      "b": "pickup",
      "reactions": [
        {
          "kind": "add_int_state",
          "state": "score",
          "value": 10
        }
      ]
    }
  ],
  "rules": [
    {
      "id": "advance_clock",
      "event": {
        "kind": "fixed_interval",
        "interval_ticks": 1
      },
      "actions": [
        {
          "kind": "add_int_state",
          "state": "clock",
          "value": 1
        }
      ]
    },
    {
      "id": "spawn_hazard_wave",
      "event": {
        "kind": "fixed_interval",
        "interval_ticks": 1
      },
      "conditions": [
        {
          "kind": "int_state",
          "state": "clock",
          "op": "ge",
          "value": 1
        },
        {
          "kind": "int_state",
          "state": "clock",
          "op": "le",
          "value": 4
        }
      ],
      "actions": [
        {
          "kind": "spawn_from_pool",
          "pool": "hazards",
          "position": {
            "kind": "constant",
            "value": [0, 3.5]
          },
          "velocity": [0, -20],
          "lifetime_ticks": 60,
          "result_state": "hazard_acquired"
        }
      ]
    },
    {
      "id": "spawn_expiring_pickup",
      "event": {
        "kind": "fixed_interval",
        "interval_ticks": 1
      },
      "conditions": [
        {
          "kind": "int_state",
          "state": "clock",
          "op": "eq",
          "value": 1
        }
      ],
      "actions": [
        {
          "kind": "spawn_from_pool",
          "pool": "pickups",
          "position": {
            "kind": "constant",
            "value": [6.5, 2.5]
          },
          "lifetime_ticks": 2,
          "result_state": "pickup_acquired"
        }
      ]
    },
    {
      "id": "prove_pickup_skip",
      "event": {
        "kind": "fixed_interval",
        "interval_ticks": 1
      },
      "conditions": [
        {
          "kind": "int_state",
          "state": "clock",
          "op": "eq",
          "value": 2
        }
      ],
      "actions": [
        {
          "kind": "spawn_from_pool",
          "pool": "pickups",
          "position": {
            "kind": "constant",
            "value": [6.5, 2.5]
          },
          "lifetime_ticks": 2,
          "result_state": "pickup_acquired"
        }
      ]
    },
    {
      "id": "spawn_collectible_pickup",
      "event": {
        "kind": "fixed_interval",
        "interval_ticks": 1
      },
      "conditions": [
        {
          "kind": "int_state",
          "state": "clock",
          "op": "eq",
          "value": 4
        }
      ],
      "actions": [
        {
          "kind": "spawn_from_pool",
          "pool": "pickups",
          "position": {
            "kind": "constant",
            "value": [0, -3.4]
          },
          "lifetime_ticks": 20,
          "result_state": "pickup_acquired"
        }
      ]
    },
    {
      "id": "reuse_released_pickup",
      "event": {
        "kind": "fixed_interval",
        "interval_ticks": 1
      },
      "conditions": [
        {
          "kind": "int_state",
          "state": "clock",
          "op": "eq",
          "value": 5
        }
      ],
      "actions": [
        {
          "kind": "spawn_from_pool",
          "pool": "pickups",
          "position": {
            "kind": "constant",
            "value": [0, -3.4]
          },
          "lifetime_ticks": 20,
          "result_state": "pickup_acquired"
        }
      ]
    },
    {
      "id": "release_hit_hazard",
      "event": {
        "kind": "collision",
        "rule": "player_hits_hazard"
      },
      "actions": [
        {
          "kind": "release_to_pool",
          "pool": "hazards",
          "target": {
            "kind": "collision_b"
          },
          "result_state": "hazard_released"
        }
      ]
    },
    {
      "id": "release_collected_pickup",
      "event": {
        "kind": "collision",
        "rule": "player_gets_pickup"
      },
      "actions": [
        {
          "kind": "release_to_pool",
          "pool": "pickups",
          "target": {
            "kind": "collision_b"
          },
          "result_state": "pickup_released"
        }
      ]
    }
  ],
  "ui": [
