{
  "schema_version": "0.6",
  "id": "lab",
  "persistent": true,
  "world": {"capacity": 8},
  "camera": {
    "mode": "follow", "position": [0, 0], "half_extent": [8, 4.5],
    "target": {"group": "player", "index": 0}, "offset": [0, 0],
    "bounds": [-4, -3, 8, 6], "pixel_snap": true
  },
  "grids": [{"id": "board", "first_cell_center": [-3.5, -1.5], "cell_size": [1, 1], "columns": 8, "rows": 4}],
  "tile_layers": [{
    "id": "floor", "grid": "board", "texture": "sprites", "atlas_columns": 4, "atlas_rows": 1,
    "fill": 1, "tint": [0.35, 0.45, 0.7, 1], "layer": -20
  }],
  "fields": [{"id": "energy", "grid": "board", "min": 0, "max": 100, "initial": 0}],
  "particle_emitters": [{
    "id": "sparks", "capacity": 16, "on_exhausted": "skip",
    "sprite": {"texture": "sprites", "size": [0.18, 0.18], "uv": [0.75, 0, 0.25, 1], "layer": 30},
    "lifetime_ticks": [8, 12], "velocity_min": [-2, 1], "velocity_max": [2, 4]
  }],
  "spawn_groups": [{
    "id": "player", "prefab": "animated_actor", "count": 1, "active_count": 1,
    "placement": {"kind": "grid", "origin": [0, 0], "spacing": [1, 1], "columns": 1}
  }],
  "pools": [],
  "systems": [{"id": "player_motion", "operation": "linear_motion", "spawn_group": "player"}],
  "collision_rules": [],
  "rules": [
    {"id": "music_on_enter", "event": {"kind": "scene_enter"}, "actions": [
      {"kind": "play_music", "asset": "theme", "loop": true, "volume": 0.25, "fade_ticks": 30}
    ]},
    {"id": "move_left", "event": {"kind": "action_pressed", "action": "move_left"}, "actions": [
      {"kind": "set_velocity", "target": {"kind": "index", "group": "player", "index": 0}, "velocity": [-6, 0]}
    ]},
    {"id": "move_right", "event": {"kind": "action_pressed", "action": "move_right"}, "actions": [
      {"kind": "set_velocity", "target": {"kind": "index", "group": "player", "index": 0}, "velocity": [6, 0]}
    ]},
    {"id": "stop_left", "event": {"kind": "action_released", "action": "move_left"}, "actions": [
      {"kind": "set_velocity", "target": {"kind": "index", "group": "player", "index": 0}, "velocity": [0, 0]}
    ]},
    {"id": "stop_right", "event": {"kind": "action_released", "action": "move_right"}, "actions": [
      {"kind": "set_velocity", "target": {"kind": "index", "group": "player", "index": 0}, "velocity": [0, 0]}
    ]},
    {"id": "burst", "event": {"kind": "action_pressed", "action": "burst"}, "actions": [
      {"kind": "play_animation", "target": {"kind": "index", "group": "player", "index": 0}, "animation": "burst", "restart": true},
      {"kind": "emit_particles", "emitter": "sparks", "particles": 4, "position": {"kind": "target", "target": {"kind": "index", "group": "player", "index": 0}}},
      {"kind": "set_tile", "layer": "floor", "x": 4, "y": 1, "value": 2, "result_state": "cell_result"},
      {"kind": "add_field", "field": "energy", "x": 4, "y": 1, "value": 5},
      {"kind": "camera_shake", "amplitude": 0.25, "duration_ticks": 6},
      {"kind": "add_int_state", "state": "score", "value": 1}
    ]},
    {"id": "resume_pulse", "event": {"kind": "animation_finished", "animation": "burst"}, "actions": [
      {"kind": "play_animation", "target": {"kind": "event_entity"}, "animation": "pulse", "restart": true}
    ]},
    {"id": "save", "event": {"kind": "action_pressed", "action": "save"}, "actions": [{"kind": "save_slot", "slot": 0, "result_state": "save_result"}]},
    {"id": "load", "event": {"kind": "action_pressed", "action": "load"}, "actions": [{"kind": "load_slot", "slot": 0, "result_state": "save_result"}]},
    {"id": "delete_save", "event": {"kind": "action_pressed", "action": "delete_save"}, "actions": [{"kind": "delete_slot", "slot": 0, "result_state": "save_result"}]},
    {"id": "locale", "event": {"kind": "action_pressed", "action": "alternate_locale"}, "actions": [{"kind": "set_locale", "locale": "alt"}]},
    {"id": "profile", "event": {"kind": "action_pressed", "action": "gamepad_profile"}, "actions": [{"kind": "set_input_profile", "profile": "gamepad"}]}
  ],
  "ui": [
    {"id": "title", "kind": "text", "position": [0, 0], "size": [250, 24], "text_key": "title", "font": "font", "color": [1, 1, 1, 1], "layer": 1000, "text_scale": 2},
    {"id": "help", "kind": "text", "position": [0, 0], "size": [330, 24], "text_key": "help", "font": "font", "color": [1, 0.85, 0.35, 1], "layer": 1000, "text_scale": 2}
  ],
  "ui_stacks": [{"id": "hud", "direction": "horizontal", "position": [24, 24], "size": [620, 64], "padding": [8, 8], "spacing": 16, "anchor": "top_left", "children": ["title", "help"]}]
}
