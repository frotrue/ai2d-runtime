{
  "schema_version": "0.5",
  "seed": 5052026,
  "name": "Pulse Salvage",
  "organization": "blackbox-lab",
  "application": "pulse-salvage",
  "window": {
    "title": "Pulse Salvage",
    "width": 960,
    "height": 540,
    "virtual_width": 960,
    "virtual_height": 540,
    "default_fps": "60"
  },
  "assets": [
    {"id": "sprites", "kind": "png", "path": "assets/sprites.png"},
    {"id": "ui_font", "kind": "font", "path": "assets/font.png", "metadata": "assets/font.json"}
  ],
  "actions": [
    {"id": "collect", "keys": ["space"]},
    {"id": "decoy", "keys": ["down"]},
    {"id": "restart", "keys": ["enter"]},
    {"id": "quit", "keys": ["escape"]}
  ],
  "states": [
    {"id": "score", "initial": 0, "min": 0, "max": 3},
    {"id": "health", "initial": 4, "min": 0, "max": 4},
    {"id": "danger", "initial": 0, "min": 0, "max": 1},
    {"id": "clearances", "initial": 0, "min": 0, "max": 999},
    {"id": "packet_spawn_ok", "initial": 0, "min": 0, "max": 1},
    {"id": "packet_second_ok", "initial": 0, "min": 0, "max": 1},
    {"id": "packet_release_ok", "initial": 0, "min": 0, "max": 1},
    {"id": "effect_spawn_ok", "initial": 0, "min": 0, "max": 1}
  ],
  "scenes": [
    {"id": "play", "path": "scenes/play.json"},
    {"id": "victory", "path": "scenes/victory.json"},
    {"id": "defeat", "path": "scenes/defeat.json"}
  ],
  "start_scene": "play",
  "transitions": [
    {
      "from": "play",
      "condition": {"kind": "int_state_at_least", "state": "score", "value": 3},
      "to": "victory"
    },
    {
      "from": "play",
      "condition": {"kind": "int_state_at_most", "state": "health", "value": 0},
      "to": "defeat"
    },
    {
      "from": "victory",
      "condition": {"kind": "action_pressed", "action": "restart"},
      "to": "play",
      "reset_scene": true,
      "reset_session": true
    },
    {
      "from": "defeat",
      "condition": {"kind": "action_pressed", "action": "restart"},
      "to": "play",
      "reset_scene": true,
      "reset_session": true
    }
  ]
}
